---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- 게시물 sitemap. lastmod = git 최종 수정 시각 (_data/sitemap_lastmod.json) -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for post in site.posts %}
  {%- assign lm = site.data.sitemap_lastmod[post.url] | default: post.last_modified_at | default: post.date %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ lm | date_to_xmlschema }}</lastmod>
    <changefreq>{% if post.categories contains '채용공고' %}weekly{% elsif post.categories contains 'Bioinformatics' %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if post.categories contains '채용공고' or post.categories contains 'Bioinformatics' %}0.8{% else %}0.6{% endif %}</priority>
  </url>
  {%- endfor %}
</urlset>
